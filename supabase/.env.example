# Variables de las Edge Functions en local. Copiá este archivo a `supabase/.env` (gitignored):
#   pnpm --filter @apocalipticba/supabase functions:serve   → usa --env-file .env
# `supabase start` sirve las funciones leyendo `supabase/functions/.env`; si lo usás sin
# functions:serve, copiá el archivo también ahí.
#
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY los inyecta el runtime local: no
# van acá.

# waitlist-signup y stubs: orígenes de navegador permitidos (coma separada). Default: la landing
# local de Astro.
ALLOWED_ORIGINS=http://localhost:4321

# waitlist-signup: sal de los buckets de rate limit (sha-256). Cualquier string largo y aleatorio;
# en staging/producción va como secret (`supabase secrets set`).
RATE_LIMIT_SALT=change-me-to-a-long-random-string
