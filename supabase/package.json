{
  "name": "@apocalipticba/supabase",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Backend local: migraciones, seeds, Edge Functions y tests de RLS",
  "type": "module",
  "scripts": {
    "start": "supabase start --workdir ..",
    "stop": "supabase stop --workdir ..",
    "status": "supabase status --workdir ..",
    "reset": "supabase db reset --workdir ..",
    "types": "node scripts/gen-types.mjs",
    "functions:serve": "supabase functions serve --workdir .. --env-file .env",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@apocalipticba/config": "workspace:*",
    "@apocalipticba/shared": "workspace:*",
    "@supabase/supabase-js": "2.118.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
